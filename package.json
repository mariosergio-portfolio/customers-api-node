{
  "name": "customers-api-node",
  "version": "1.0.0",
  "description": "REST API for querying customers with partial text search filters and AWS Polly name pronunciation",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/**/*.test.js\"",
    "lint": "eslint ."
  },
  "author": "Mário Sergio",
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/client-polly": "3.1139.0",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "pino-pretty": "13.1.3",
    "supertest": "7.3.0"
  }
}
