# Copy to .env for local development (loaded via `node --env-file-if-exists=.env`).
NODE_ENV=development
PORT=8082
LOG_LEVEL=debug

DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=123
DB_SSL=false
DB_POOL_MAX=10

AWS_REGION=us-east-1
AWS_POLLY_VOICE_ID=Joanna
# Not required when logged in with `aws login` / SSO / an IAM role (default credentials chain).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

CORS_ORIGIN=*
TRUST_PROXY=false
PRONOUNCE_RATE_LIMIT_PER_MINUTE=30
